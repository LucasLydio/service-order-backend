# MySQL connection settings
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=service_order
MYSQL_USER=root
MYSQL_PASSWORD=root

# Optional: if you prefer, you can set a ready-made SQLAlchemy URL instead.
# DATABASE_URL=mysql+pymysql://root:password@localhost:3306/service_order

# App settings
JWT_SECRET_KEY=your-secret-key-here-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24
ENVIRONMENT=development

# Demo admin bootstrap values
ADMIN_NAME="Admin"
ADMIN_EMAIL="admin@email.com"
ADMIN_PASSWORD="change-me"
